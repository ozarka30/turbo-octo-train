# Only needed for the API backend. Leave unset to use your Claude subscription through Claude Code (`claude -p`).
# Get one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
# JPTUTOR_BACKEND=auto             # auto | api | claude-code
# JPTUTOR_TUTOR_MODEL=claude-opus-5
# JPTUTOR_OCR_MODEL=claude-opus-5
# JPTUTOR_LEVEL=beginner            # beginner | intermediate | advanced
# JPTUTOR_JA_VOICE=ja-JP-NanamiNeural
# JPTUTOR_EN_VOICE=en-US-AriaNeural
# JPTUTOR_REGION=0,800,1920,280     # x,y,width,height of the dialogue box (screen pixels)
# JPTUTOR_POLL_INTERVAL=0.5         # seconds between screen grabs
# JPTUTOR_CHANGE_THRESHOLD=0.02     # fraction of pixels that must change to count as new text
# JPTUTOR_OVERLAY=1                 # 0 to hide the on-screen highlight window
# JPTUTOR_OVERLAY_GEOMETRY=40,800,1840,200
# JPTUTOR_OVERLAY_FONT_SIZE=34
# JPTUTOR_OVERLAY_OPACITY=0.88
# JPTUTOR_MEMORY=~/.jptutor/memory.sqlite   # 0 to disable long-term memory
# JPTUTOR_REPEAT=quick              # line from an earlier session: quick | skip | full
# JPTUTOR_CACHE_TTL=1h              # prompt-cache TTL for the API backend: 5m | 1h
# JPTUTOR_KNOWLEDGE_REFRESH=6       # lessons between memory-summary snapshots
# JPTUTOR_TTS=auto                  # edge | system | auto
# JPTUTOR_PRACTICE=hotkey           # off | hotkey (F7) | auto (after every lesson)
# JPTUTOR_WHISPER_MODEL=small       # tiny | base | small | medium
# JPTUTOR_HOTKEY_MAP=capture=<f8>,skip=<f9>,pause=<f10>,repeat=<f11>,practice=<f7>
# JPTUTOR_AUTO_REGION=0             # 1 to let the first OCR result choose the dialogue box
