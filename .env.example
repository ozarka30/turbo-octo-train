# Only needed for the API backend. Leave unset to use your Claude subscription through Claude Code (`claude -p`).
# Get one at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
# JPTUTOR_BACKEND=auto             # auto | api | claude-code
# JPTUTOR_TUTOR_MODEL=claude-opus-5
# JPTUTOR_OCR_MODEL=claude-opus-5
# JPTUTOR_LEVEL=beginner            # beginner | intermediate | advanced
# JPTUTOR_JA_VOICE=ja-JP-NanamiNeural
# JPTUTOR_EN_VOICE=en-US-AriaNeural
# JPTUTOR_REGION=0,800,1920,280     # x,y,width,height of the dialogue box (screen pixels)
# JPTUTOR_POLL_INTERVAL=0.5         # seconds between screen grabs
# JPTUTOR_CHANGE_THRESHOLD=0.02     # fraction of pixels that must change to count as new text
